<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #1b2e1b;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.slimene.demo5.AlertsController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="⚠️ Alertes Météo" />
        <Region HBox.hgrow="ALWAYS" />
        <Button style="-fx-background-color: #1a4a6b; -fx-text-fill: white; -fx-padding: 8 18; -fx-background-radius: 20; -fx-cursor: hand;" text="🔄 Synchroniser météo" />
        <Button style="-fx-background-color: #7ec850; -fx-text-fill: #132613; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 20; -fx-cursor: hand;" text="+ Créer alerte" />
    </HBox>

    <!-- Current Weather Card -->
    <HBox spacing="20" style="-fx-background-color: #1a3a5c; -fx-background-radius: 14; -fx-padding: 20;">
        <VBox spacing="4">
            <Label style="-fx-text-fill: #8ac4df; -fx-font-size: 12;" text="Météo actuelle" />
            <Label fx:id="lblCurrentWeather" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="☀️ Ensoleillé — 26°C" />
            <Label fx:id="lblHumidity" style="-fx-text-fill: #aaa; -fx-font-size: 13;" text="Humidité : 58% | Vent : 12 km/h" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="CENTER_RIGHT" spacing="4">
            <Label style="-fx-text-fill: #888; -fx-font-size: 11;" text="Dernière mise à jour" />
            <Label fx:id="lblLastSync" style="-fx-text-fill: #8ac4df; -fx-font-size: 13;" text="Aujourd'hui, 10:30" />
        </VBox>
    </HBox>

    <!-- Alerts Table -->
    <TableView fx:id="alertsTable" style="-fx-background-color: #243824; -fx-background-radius: 12;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colAlertId" prefWidth="60" text="ID" />
            <TableColumn fx:id="colAlertType" prefWidth="140" text="Type" />
            <TableColumn fx:id="colAlertMessage" prefWidth="300" text="Message" />
            <TableColumn fx:id="colAlertPlant" prefWidth="160" text="Plante concernée" />
            <TableColumn fx:id="colAlertDate" prefWidth="130" text="Date" />
            <TableColumn fx:id="colAlertSeverity" prefWidth="100" text="Sévérité" />
            <TableColumn fx:id="colAlertStatus" prefWidth="100" text="Statut" />
            <TableColumn fx:id="colAlertActions" prefWidth="100" text="Actions" />
        </columns>
    </TableView>
</VBox>
