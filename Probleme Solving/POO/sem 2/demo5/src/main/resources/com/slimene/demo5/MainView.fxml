<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.slimene.demo5.MainController"
            prefWidth="1200" prefHeight="750"
            style="-fx-background-color: #1b2e1b;">

    <!-- Sidebar Navigation -->
    <left>
        <VBox prefWidth="220" style="-fx-background-color: #132613; -fx-padding: 20;">
            <Label text="🌿 UrbanGarden" style="-fx-text-fill: #7ec850; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 30 0;"/>
            <Button fx:id="btnDashboard" text="📊  Dashboard"
                    maxWidth="Infinity" style="-fx-background-color: #2e5c2e; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            <Button fx:id="btnPlants" text="🌱  Mes Plantes"
                    maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #aaa; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            <Button fx:id="btnPlanning" text="📅  Planning"
                    maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #aaa; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            <Button fx:id="btnGardens" text="🏡  Jardins Partagés"
                    maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #aaa; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            <Button fx:id="btnAlerts" text="⚠️  Alertes Météo"
                    maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #aaa; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            <Button fx:id="btnUsers" text="👤  Utilisateurs"
                    maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #aaa; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪  Déconnexion"
                    maxWidth="Infinity" style="-fx-background-color: #4a1a1a; -fx-text-fill: #ff6b6b; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- Main Content Area (swapped by controller) -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #1b2e1b;"/>
    </center>
</BorderPane>