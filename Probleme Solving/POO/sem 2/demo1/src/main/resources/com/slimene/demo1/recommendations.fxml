<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.*?>

<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="700" prefHeight="500">

    <!-- TOP TITLE -->
    <top>
        <Label text="🌱 Recommendations to Reduce CO₂"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="🚗 Use public transport or bike"
                   style="-fx-font-size: 14px;"/>

            <Label text="🍽️ Reduce meat consumption"
                   style="-fx-font-size: 14px;"/>

            <Label text="💡 Turn off unused lights"
                   style="-fx-font-size: 14px;"/>

            <Label text="🔌 Use energy-efficient appliances"
                   style="-fx-font-size: 14px;"/>

            <Label text="🌳 Plant trees or support eco projects"
                   style="-fx-font-size: 14px;"/>

        </VBox>
    </center>

    <!-- BOTTOM BUTTON -->
    <bottom>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="10" bottom="20"/>
            </padding>

            <Button text="⬅ Back"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        </HBox>
    </bottom>

</BorderPane>
