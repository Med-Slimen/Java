<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.chart.PieChart?>

<?import javafx.scene.control.*?>

<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="900" prefHeight="600">

    <!-- TOP -->
    <top>
        <Label text="🌍 Carbon Footprint Calculator"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- LEFT (INPUTS) -->
    <left>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="🚗 Distance (km)" />
            <TextField promptText="Ex: 10"/>

            <Label text="🍔 Meals (meat)" />
            <TextField promptText="Ex: 2"/>

            <Label text="💡 Electricity (kWh)" />
            <TextField promptText="Ex: 5"/>

            <Button text="Calculate"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <!-- CENTER (RESULT + CHART) -->
    <center>
        <VBox alignment="CENTER" spacing="20">

            <Label text="Result"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="0 kg CO2"
                   style="-fx-font-size: 24px; -fx-text-fill: green;"/>

            <PieChart prefWidth="400" prefHeight="400"/>

        </VBox>
    </center>

</BorderPane>
